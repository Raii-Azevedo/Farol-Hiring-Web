# =====================================================================
# MODELO: copie para .env.local (local) ou cadastre na Vercel
# (Project → Settings → Environment Variables). Nunca commite o .env.local.
# =====================================================================

# ---- BigQuery --------------------------------------------------------
# JSON da service account, cru ou em base64 (base64 evita problema com
# as quebras de linha da private_key no painel da Vercel):
#   base64 -w0 chave.json
# Sem esta variável, o app usa a credencial da máquina
# (gcloud auth application-default login) local, ou a service account
# anexada ao serviço no Cloud Run (produção: sem chave, não preencha).
# Roles necessárias: ver README, seção "Service account".
GCP_SERVICE_ACCOUNT_JSON=

# Opcionais (os padrões já são estes)
# BQ_PROJECT=br-in-dataplatform
# BQ_DATASET=greenhouse_dev
# BQ_LOCATION=

# ---- Login com Google (Auth.js) -------------------------------------
# Sem AUTH_GOOGLE_ID/SECRET: em `npm run dev` roda em modo aberto com
# aviso; em produção o app BLOQUEIA o acesso.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Segredo para assinar a sessão: `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=
# Opcional: restringe o seletor de conta do Google ao domínio
# AUTH_GOOGLE_HD=artefact.com
